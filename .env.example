GATEWAY_TOKEN=replace-with-a-long-random-token
MODEL_BASE_URL=https://your-provider.example/v1
MODEL_API_KEY=your-provider-api-key
MODEL_NAME=your-model-id
# 可选：多服务商/自然语言换模型。也可直接在 /models 手机页保存，已保存配置优先。
# MODEL_ROUTES_PATH=./models.local.json
HOST=127.0.0.1
PORT=8787
CONFIG_PATH=./config.example.json
DATABASE_PATH=./data/family.sqlite
# MCP 部署目录、凭据密钥。留空密钥时自动创建私有 vault.key，需与数据库一起备份。
MCP_DATA_DIR=./data/mcp
# MCP_SECRET_KEY=
# 只有服务器管理员能允许访问这些私有/HTTP 主机，模型清单不能扩大名单。
# MCP_PRIVATE_HOSTS=127.0.0.1,localhost
# 家庭工作区、任务、跨端文件和通知。留空 CHANNELS_PATH 时用手机工作台保存的平台绑定。
WORLD_DATA_DIR=./data/world
# CHANNELS_PATH=./channels.local.json
CHANNEL_HTTP_HOSTS=127.0.0.1,localhost
# 供微信 Clawbot / OpenClaw 下载媒体的网关外部 HTTPS 地址。
# PUBLIC_BASE_URL=https://your-gateway.example
# 可选：兼容 /audio/speech 的语音服务完整地址。也可使用 MCP 生成的音频。
# VOICE_SERVICE_URL=https://your-speech-provider.example/v1/audio/speech
# VOICE_API_KEY=
# VOICE_MODEL=
# VOICE_VOICES={"korax":"your-korax-voice","kirishima":"your-kirishima-voice"}

# 定时读取/工具箱仅访问公开 HTTPS。只有管理员能显式放行本地测试或私有站点。
# CRAWL_PRIVATE_HOSTS=127.0.0.1
# 可选系统工具：pdftotext 用于工具箱 PDF 文本读取。缺少时保留原文件并标待处理。
# 可选：IDE 网页组件跨域接入，只能填精确 HTTP(S) origin，以逗号分隔；仍须 API Key。
# IDE_ORIGINS=https://your-ide.example,http://localhost:5173
